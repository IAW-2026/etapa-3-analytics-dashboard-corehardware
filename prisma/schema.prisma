// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SourceApp {
  BUYER
  SELLER
  SHIPPING
  PAYMENTS
}

enum SyncStatus {
  OK
  DEGRADED
  ERROR
}

// Un registro por app, se sobreescribe/actualiza en cada sync.
// Guarda el estado de salud + metadata de la última sincronización.
model ApiSyncStatus {
  id           String     @id @default(cuid())
  app          SourceApp  @unique
  status       SyncStatus
  lastSyncedAt DateTime   @updatedAt
  message      String?

  @@map("api_sync_status")
}

// KPIs agregados del dashboard, uno por día (alimenta KpiStrip y TrendChart)
model DashboardSnapshot {
  id              String   @id @default(cuid())
  date            DateTime @db.Date
  gmv             Decimal  @db.Decimal(14, 2)
  orders          Int
  pendingShipping Int
  settled         Decimal  @db.Decimal(14, 2)
  activeUsers     Int
  createdAt       DateTime @default(now())

  @@unique([date])
  @@map("dashboard_snapshots")
}

// Distribución de pedidos por estado (alimenta OrderStatusDonut)
model OrderStatusSnapshot {
  id     String   @id @default(cuid())
  date   DateTime @db.Date
  status String
  count  Int

  @@unique([date, status])
  @@map("order_status_snapshots")
}

// Resumen por app (alimenta AppSummaryTable)
model AppSummarySnapshot {
  id     String    @id @default(cuid())
  app    SourceApp
  date   DateTime  @db.Date
  metric String
  value  Decimal   @db.Decimal(14, 2)

  @@unique([app, date, metric])
  @@map("app_summary_snapshots")
}

// Ingresos diarios, desglosados producto vs envío (alimenta line chart de ingresos y ticket promedio)
model DailyRevenueSnapshot {
  id               String   @id @default(cuid())
  date             DateTime @db.Date
  revenueProductos Decimal  @db.Decimal(14, 2)
  revenueEnvio     Decimal  @db.Decimal(14, 2)
  revenueTotal     Decimal  @db.Decimal(14, 2)
  ordersCount      Int
  ticketPromedio   Decimal  @db.Decimal(14, 2)
  createdAt        DateTime @default(now())

  @@unique([date])
  @@map("daily_revenue_snapshots")
}

// Volumen por vendedor, uno por día (se agrupa por sellerId y se suma en el rango para el ranking)
// sellerName queda nullable porque depende del endpoint nuevo de Seller (api/analytics/sellers);
// hasta que esté disponible, se guarda null y la UI cae a mostrar sellerId.
model TopSellerSnapshot {
  id         String   @id @default(cuid())
  date       DateTime @db.Date
  sellerId   String
  sellerName String?
  orders     Int
  revenue    Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now())

  @@unique([date, sellerId])
  @@map("top_seller_snapshots")
}

// Cantidad pedida por producto, uno por día (se agrupa por productId y se suma en el rango)
// productName nullable por la misma razón que sellerName arriba (api/analytics/products pendiente).
model TopProductSnapshot {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  productId   String
  productName String?
  quantity    Int
  createdAt   DateTime @default(now())

  @@unique([date, productId])
  @@map("top_product_snapshots")
}

// Compradores nuevos por día, calculado por createdAt de Comprador (Buyer).
// Solo confiable desde la fecha de la migración que agregó createdAt en adelante.
model NewBuyersSnapshot {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  count     Int
  createdAt DateTime @default(now())

  @@unique([date])
  @@map("new_buyers_snapshots")
}